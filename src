<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Aya Bahloul - Web Developer</title>
    <script src="https://kit.fontawesome.com/a9cdbedf57.js" crossorigin="anonymous"></script>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        html { scroll-behavior: smooth; }
        body {
            font-family: 'Segoe UI', sans-serif;
            background: #1a0a12;
            color: #fff;
        }

        .welcome-screen {
            position: fixed;
            top: 0; left: 0;
            width: 100%; height: 100vh;
            background: linear-gradient(135deg, #1a0a12 0%, #2d1424 100%);
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            z-index: 9999;
            animation: fadeOut 1s ease 3s forwards;
            overflow: hidden;
        }
        .welcome-content { text-align: center; animation: slideUp 1s ease; z-index: 10; }
        .welcome-icons {
            display: flex;
            gap: 20px;
            justify-content: center;
            margin-bottom: 40px;
        }
        .icon-circle {
            width: 50px; height: 50px;
            background: rgba(236, 72, 153, 0.2);
            border: 2px solid #ec4899;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
            color: #ec4899;
            animation: pulse 2s infinite;
        }
        .welcome-content h2 { font-size: 36px; color: #fff; margin-bottom: 10px; }
        .welcome-content h1 { font-size: 48px; color: #f3d1dc; margin-bottom: 20px; }
        .welcome-content h1 span {
            background: linear-gradient(90deg, #ec4899, #f472b6);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .rain {
            position: absolute;
            top: 0; left: 0;
            width: 100%; height: 100%;
            pointer-events: none;
            overflow: hidden;
        }
        .rain span {
            position: absolute;
            width: 4px;
            height: 4px;
            background: #ec4899;
            border-radius: 50%;
            box-shadow: 0 0 8px rgba(236, 72, 153, 0.8);
            animation: rainDrop 2s linear infinite;
            opacity: 0.7;
        }

        @keyframes slideUp {
            from { opacity: 0; transform: translateY(30px); }
            to { opacity: 1; transform: translateY(0); }
        }
        @keyframes pulse {
            0%, 100% { transform: scale(1); }
            50% { transform: scale(1.1); }
        }
        @keyframes fadeOut {
            to { opacity: 0; visibility: hidden; }
        }
        @keyframes rainDrop {
            0% { transform: translateY(-20px); opacity: 0; }
            10% { opacity: 0.7; }
            100% { transform: translateY(100vh); opacity: 0; }
        }

        nav {
            position: fixed;
            top: 0; width: 100%;
            padding: 20px 50px;
            background: rgba(26, 10, 18, 0.95);
            display: flex; justify-content: space-between; align-items: center;
            z-index: 1000;
        }
        .logo { font-size: 22px; font-weight: 700; }
        .logo span { color: #ec4899; }
        .nav-links { display: flex; gap: 35px; list-style: none; }
        .nav-links a { color: #f3d1dc; text-decoration: none; transition: 0.3s; font-weight: 500; }
        .nav-links a:hover, .nav-links a.active { color: #ec4899; }
        
        .hero {
            min-height: 100vh; padding: 140px 50px 80px;
            display: flex; align-items: center;
            background: linear-gradient(135deg, #1a0a12 0%, #2d1424 100%);
        }
        .hero-content {
            max-width: 1200px; margin: 0 auto;
            display: grid; grid-template-columns: 1fr 1fr; gap: 60px; align-items: center;
        }
        .hero-text h3 { color: #f472b6; font-size: 18px; margin-bottom: 10px; }
        .hero-text h1 { font-size: 60px; margin-bottom: 20px; }
        .hero-text h1 span { color: #ec4899; }
        .hero-text p { color: #f3d1dc; margin-bottom: 30px; max-width: 500px; line-height: 1.8; }
        .btn-group { display: flex; gap: 15px; }
        .btn {
            padding: 12px 28px; border-radius: 8px; text-decoration: none;
            font-weight: 600; transition: 0.3s; display: flex; align-items: center; gap: 8px;
        }
        .btn-primary { background: #ec4899; color: #fff; }
        .btn-primary:hover { background: #db2777; }
        .btn-outline { border: 2px solid #4d1a2f; color: #f3d1dc; }
        .btn-outline:hover { background: #2d1424; }
        .hero-img img {
            width: 100%; max-width: 400px; border-radius: 20px;
            box-shadow: 0 0 50px rgba(236, 72, 153, 0.5);
        }
        
        section { padding: 80px 50px; }
        .container { max-width: 1200px; margin: 0 auto; }
        .section-title { text-align: center; font-size: 40px; margin-bottom: 60px; }
        .section-title span { color: #ec4899; border-bottom: 3px solid #ec4899; }
        
        .about-content {
            display: grid; grid-template-columns: 1fr 1fr; gap: 60px; align-items: center;
        }
        .about-img img { 
            width: 280px;
            height: 280px;
            object-fit: cover;
            border-radius: 15px;
            box-shadow: 0 0 30px rgba(236, 72, 153, 0.4);
            display: block;
            margin: 0 auto;
        }
        .about-text h3 { color: #f472b6; font-size: 16px; margin-bottom: 10px; }
        .about-text h2 { font-size: 38px; margin-bottom: 20px; line-height: 1.3; }
        .about-text h2 span { color: #ec4899; }
        .about-text p { color: #f3d1dc; margin-bottom: 30px; line-height: 1.8; }
        
        #projects { background: #1f0f1a; }
        .projects-grid {
            display: grid; grid-template-columns: repeat(3, 1fr); gap: 30px;
        }
        .project-card {
            background: #2d1424; padding: 30px; border-radius: 15px;
            border: 1px solid #4d1a2f; transition: 0.3s;
        }
        .project-card:hover { transform: translateY(-8px); border-color: #ec4899; }
        .project-icon {
            width: 60px; height: 60px; 
            background: linear-gradient(135deg, #ec4899 0%, #f472b6 100%);
            border-radius: 15px; display: flex; align-items: center; justify-content: center;
            font-size: 28px; color: #fff; margin-bottom: 20px;
            box-shadow: 0 4px 15px rgba(236, 72, 153, 0.4);
        }
        .project-card h3 { margin-bottom: 12px; font-size: 20px; }
        .project-card p { color: #f3d1dc; font-size: 14px; margin-bottom: 20px; line-height: 1.6; }
        .project-card a {
            color: #ec4899; text-decoration: none; font-weight: 600;
            display: inline-flex; align-items: center; gap: 5px;
        }
        
        .contact-wrapper {
            display: grid; grid-template-columns: 2fr 1fr; gap: 30px;
            max-width: 1000px; margin: 0 auto;
        }
        .contact-form {
            display: grid; grid-template-columns: 1fr 1fr; gap: 20px;
        }
        .contact-form input, .contact-form textarea {
            padding: 14px; 
            background: rgba(45, 20, 36, 0.8);
            border: 2px solid #4d1a2f;
            border-radius: 8px; 
            color: #fff;
            font-family: inherit;
            font-size: 15px;
            transition: 0.3s;
        }
        .contact-form input:focus, .contact-form textarea:focus {
            outline: none;
            border-color: #ec4899;
            box-shadow: 0 0 10px rgba(236, 72, 153, 0.3);
        }
        .contact-form input::placeholder, .contact-form textarea::placeholder {
            color: #f3d1dc;
            opacity: 0.6;
        }
        .contact-form textarea { grid-column: 1 / 3; min-height: 120px; }
        .btn-submit {
            grid-column: 1 / 3; 
            padding: 14px; 
            background: linear-gradient(135deg, #ec4899 0%, #f472b6 100%);
            color: #fff;
            border: none; 
            border-radius: 8px; 
            font-weight: 700; 
            cursor: pointer;
            transition: 0.3s;
            font-size: 15px;
            letter-spacing: 0.5px;
        }
        .btn-submit:hover { 
            background: linear-gradient(135deg, #db2777 0%, #ec4899 100%);
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(236, 72, 153, 0.4);
        }
        
        .social-contact {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 15px;
        }
        .social-box {
            background: rgba(45, 20, 36, 0.8); 
            border: 2px solid #4d1a2f; 
            border-radius: 10px;
            display: flex; 
            align-items: center; 
            justify-content: center; 
            gap: 8px;
            color: #ec4899; 
            text-decoration: none; 
            font-weight: 600; 
            transition: 0.3s;
            font-size: 15px;
            padding: 20px;
            min-height: 80px;
        }
        .social-box:hover { 
            border-color: #ec4899; 
            background: rgba(236, 72, 153, 0.2); 
            color: #fff;
            transform: translateY(-3px);
        }
        .social-box i { font-size: 22px; }
        
        footer { 
            padding: 30px 50px; text-align: center; border-top: 1px solid #2d1424; 
            color: #a78b9c; display: flex; justify-content: space-between; align-items: center;
        }
        footer span { color: #ec4899; }
        
        @media (max-width: 768px) {
            nav { padding: 20px; }
            .nav-links { display: none; }
            .welcome-content h1 { font-size: 32px; }
            .welcome-content h2 { font-size: 24px; }
            .hero-content, .about-content { grid-template-columns: 1fr; text-align: center; }
            .hero-text h1 { font-size: 40px; }
            .about-img img { width: 240px; height: 240px; }
            .projects-grid { grid-template-columns: 1fr; }
            .contact-wrapper { grid-template-columns: 1fr; }
            .contact-form { grid-template-columns: 1fr; }
            .contact-form textarea, .btn-submit { grid-column: 1; }
            .social-contact { grid-template-columns: 1fr; }
            .btn-group { justify-content: center; }
            footer { flex-direction: column; gap: 20px; }
        }
    </style>
</head>
